rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Learner document & media attachments uploaded directly from the frontend
    // Owners can write/read their own folder; tokenized download URLs stored in
    // Firestore (protected by firestore.rules) allow Registrar staff to preview files.
    match /requests/{uid}/{kind}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == uid
        && kind in ['id', 'proof', 'photo']
        && fileName.size() <= 180
        && request.resource != null
        && request.resource.size > 0
        && (
          (kind == 'photo'
            && request.resource.size <= 15 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'))
          ||
          (kind in ['id', 'proof']
            && (
              (request.resource.size <= 15 * 1024 * 1024
                && (request.resource.contentType.matches('image/.*')
                  || request.resource.contentType == 'application/pdf'))
              ||
              (request.resource.size <= 50 * 1024 * 1024
                && request.resource.contentType.matches('video/.*'))
            ))
        );
    }
  }
}
